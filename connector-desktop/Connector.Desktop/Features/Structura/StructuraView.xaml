<UserControl x:Class="Connector.Desktop.Features.Structura.StructuraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource CardStyle}" Margin="12,10,12,12">
            <StackPanel>
                <TextBlock Text="Сервисы Structura" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Быстрый переход к рабочим веб-сервисам Structura. Доступы привязаны к вашему токену и приходят с сервера вместе с подключением."
                           Margin="0,6,0,14"
                           Foreground="#A9BBD3"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding AccessStatusLine}" Foreground="#A9BBD3" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="14" BorderBrush="#2A3E5C" BorderThickness="1" CornerRadius="12" Margin="0,0,8,12">
                        <StackPanel>
                            <TextBlock Text="Сервер моделей - Speckle" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Переход к серверу моделей и учетные данные для входа."
                                       Foreground="#A9BBD3"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Открыть" Command="{Binding OpenSpeckleCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Доступы" Command="{Binding ShowSpeckleAccessCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="14" BorderBrush="#2A3E5C" BorderThickness="1" CornerRadius="12" Margin="8,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Среда взаимодействия - Nextcloud" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Переход к среде взаимодействия и учетные данные для входа."
                                       Foreground="#A9BBD3"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Открыть" Command="{Binding OpenNextcloudCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Доступы" Command="{Binding ShowNextcloudAccessCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
