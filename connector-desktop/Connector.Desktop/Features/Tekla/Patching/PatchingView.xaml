<UserControl x:Class="Connector.Desktop.Features.Tekla.Patching.PatchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- self-contained dark-theme button styles (the keyed styles live in MainWindow scope; a shared
             Theme.xaml in App.xaml is a later foundation step) -->
        <Style x:Key="P_Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#D6E2F2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="r" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="r" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="r" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="P_Secondary" TargetType="Button" BasedOn="{StaticResource P_Btn}">
            <Setter Property="Background" Value="#16202E" />
            <Setter Property="BorderBrush" Value="#2A3444" />
        </Style>
        <Style x:Key="P_Primary" TargetType="Button" BasedOn="{StaticResource P_Btn}">
            <Setter Property="Background" Value="#2D7DD2" />
            <Setter Property="Foreground" Value="#06101C" />
            <Setter Property="BorderBrush" Value="#8FC2F2" />
        </Style>
        <Style x:Key="P_TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D121A" />
            <Setter Property="Foreground" Value="#D6E2F2" />
            <Setter Property="BorderBrush" Value="#2A3444" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </UserControl.Resources>

    <!-- self-wraps in ScrollViewer + CardStyle so the Tekla TabControl can host it via a bare ContentControl
         (data-driven nav), consistent with the other Tekla module views. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource CardStyle}" Margin="12,10,12,12">
    <StackPanel Margin="4">
        <TextBlock Text="Патчинг IFC-экспорта" FontWeight="SemiBold" FontSize="15" Foreground="#E6EEFA" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="#9FB1CC" Margin="0,0,0,10"
                   Text="Расширяет нативный IFC-экспорт Tekla (62 сущности «Объект IFC», persist, сущности в наборах свойств). Заменяет системные DLL с резервной копией; откат — в один клик. Tekla должна быть закрыта." />

        <Border Background="#0D121A" BorderBrush="#22344A" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusLine}" Foreground="#A9BBD3" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Папка bin Tekla" Foreground="#9FB1CC" Margin="0,0,0,2" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource P_TextBox}" Text="{Binding TeklaBin, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource P_Secondary}" Margin="8,0,0,0" Click="BrowseBin_Click" />
        </Grid>

        <TextBlock Text="Набор патча (под версию Tekla)" Foreground="#9FB1CC" Margin="0,0,0,2" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource P_TextBox}" Text="{Binding StagingDir, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource P_Secondary}" Margin="8,0,0,0" Click="BrowseStaging_Click" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Проверить" Command="{Binding DetectCommand}" Style="{StaticResource P_Secondary}" />
            <Button Content="Установить патч" Command="{Binding ApplyCommand}" Style="{StaticResource P_Primary}" Margin="8,0,0,0" />
            <Button Content="Откатить" Command="{Binding RollbackCommand}" Style="{StaticResource P_Secondary}" Margin="8,0,0,0" />
            <Button Content="Открыть лог" Command="{Binding OpenLogCommand}" Style="{StaticResource P_Secondary}" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Foreground="#A9BBD3" Margin="0,12,0,0" />
    </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
